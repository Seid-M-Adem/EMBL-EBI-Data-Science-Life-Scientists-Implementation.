# Consistent formatting in every editor (VS Code, Cursor, PyCharm, Vim, …). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[{*.yml,*.yaml,*.json,*.ipynb,*.cff}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
