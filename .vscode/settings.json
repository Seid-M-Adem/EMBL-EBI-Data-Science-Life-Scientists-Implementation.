{
  // Shared workspace settings (VS Code / Cursor). See RUNNING.md.
  // Use the repository's virtual environment for scripts, notebooks and the integrated terminal.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Run every notebook with its own folder as working directory, so relative paths
  // (people.tsv, data.csv, the anaemia dataset, ...) resolve exactly as in Jupyter Lab.
  "jupyter.notebookFileRoot": "${fileDirname}",

  // Ruff (same rules as CI, configured in ruff.toml).
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true,
    "**/.ruff_cache": true,
    "**/.snakemake": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/course_materials/local": true,
    "data/raw": true
  },
  "files.associations": { "Snakefile": "snakemake", "*.smk": "snakemake" }
}
